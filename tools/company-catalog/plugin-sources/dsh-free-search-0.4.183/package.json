{
  "name": "dsh-free-search",
  "version": "0.4.183",
  "description": "Free web search for DeepSeek Harness, company-hardened build of upstream v0.4.18: reviewed keyed-only engine chain tavily -> exa -> anysearch (each engine joins only with its self-registered free API key; zero keys answer with setup guidance — the keyless bing/ddg engines were removed in 0.4.183), settings-section key configuration, no self-update path (updates arrive through the company catalog channel).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./engines": "./lib/engines.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/engines.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "tavily",
    "exa",
    "anysearch",
    "search",
    "free"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DDDMUC/dsh-free-search.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    }
  }
}
