{
  "name": "dsh-dai-engramory",
  "version": "0.2.4",
  "description": "Curated file-based long-term memory for DeepSeek Harness — human-readable markdown notes, one plain-file store shared across hosts (git-ignored when it lives inside a project repo), and a deterministic index cap enforced by ctx.tools.guard()",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "memory",
    "agent-memory",
    "long-term-memory",
    "engramory",
    "markdown"
  ],
  "type": "module",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinqiao-oss/engramory.git",
    "directory": "adapters/dsh/plugin"
  },
  "homepage": "https://github.com/tinqiao-oss/engramory/tree/master/adapters/dsh#readme",
  "bugs": {
    "url": "https://github.com/tinqiao-oss/engramory/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
