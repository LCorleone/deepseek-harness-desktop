  "scripts": {
    "build": "yarn workspace dsh-community-market build && yarn workspace dsh-plugin-desktop build",
    "typecheck": "yarn workspace dsh-plugin-desktop typecheck && yarn workspace dsh-community-market typecheck && yarn workspace dsh-company-skills typecheck",
    "test": "yarn workspace dsh-plugin-desktop test && yarn workspace dsh-community-market test && yarn workspace dsh-company-skills test",
    "test:bilingual-docs": "node --test scripts/bilingual-docs.test.mjs",
    "check:bilingual-docs": "yarn test:bilingual-docs && node scripts/verify-bilingual-docs.mjs",
    "test:architecture-gates": "node --test scripts/market-dependency-direction.test.mjs scripts/dsh-runtime-version-parity.test.mjs",
    "check:architecture": "yarn test:architecture-gates && node scripts/verify-market-dependency-direction.mjs",
    "check:layout": "yarn check:bilingual-docs && yarn check:architecture && node scripts/verify-layout.mjs",
    "test:company-catalog": "node --test tools/company-catalog/tests/accept-handoff.test.mjs tools/company-catalog/tests/allowlist-tarball.test.mjs tools/company-catalog/tests/beta-channel.test.mjs tools/company-catalog/tests/dsh-free-search.test.mjs tools/company-catalog/tests/manifest-tarball.test.mjs tools/company-catalog/tests/pack-surface.test.mjs tools/company-catalog/tests/publish-removal-guard.test.mjs tools/company-catalog/tests/tarball-publish.test.mjs tools/company-catalog/tests/tarball.test.mjs tools/company-catalog/tests/verify-handoff.test.mjs",
    "check:company-catalog": "yarn test:company-catalog && node tools/company-catalog/e2e-tarball.mjs",
    "test:company-skills": "node --test tools/company-skills/tests/bundle-format.test.mjs tools/company-skills/tests/pack-roundtrip.test.mjs tools/company-skills/tests/unpack-release-guard.test.mjs",
    "check": "yarn check:layout && yarn workspace dsh-community-fabric check && yarn workspace dsh-community-market check && yarn workspace dsh-company-skills check && yarn workspace dsh-plugin-desktop check && yarn check:company-catalog && yarn test:company-skills",
    "catalog": "node tools/company-catalog/cli.mjs",
    "catalog:measure": "node tools/company-catalog/measure.mjs",
    "dev": "yarn workspace dsh-community-market build && yarn workspace dsh-plugin-desktop dev",
    "start": "yarn workspace dsh-plugin-desktop start",
    "package:dir": "yarn workspace dsh-community-market build && yarn workspace dsh-plugin-desktop package:dir",
    "e2e:install-smoke": "node dsh-plugin-desktop/scripts/e2e-install-smoke.mjs",
    "dist:mac": "yarn workspace dsh-community-market build && yarn workspace dsh-plugin-desktop dist:mac",
    "dist:mac-smoke": "yarn workspace dsh-community-market build && yarn workspace dsh-plugin-desktop dist:mac-smoke",
    "dist:win": "yarn workspace dsh-community-market build && yarn workspace dsh-plugin-desktop dist:win",
    "dist:win-portable": "yarn workspace dsh-community-market build && yarn workspace dsh-plugin-desktop dist:win-portable",
    "upstream:version": "cd deepseek-harness && corepack pnpm --version",
    "upstream:install": "cd deepseek-harness && corepack pnpm install --frozen-lockfile",
    "upstream:build": "cd deepseek-harness && corepack pnpm run build"
  }
}
